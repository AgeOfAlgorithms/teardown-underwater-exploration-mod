<prefab version="1.6.0">
	<!-- The harpoon gun's tool (harpoon.lua registers it): laid out like the game's data/prefab/tool/rifle.xml. Tool
	     space origin = the right hand's grip, forward = -z. The gun model (0.9 m) and the loaded spear (1.2 m, tagged
	     harpoonspear: the script hides it while reloading) are tools/make_harpoon.py's, both at 0.05 m voxels and
	     placed by their centres. The muzzle is the loaded spear's point. -->
	<group name="instance=MOD/prefab/harpoon.xml" pos="0 0 0" rot="0.0 0.0 0.0">
		<group name="eye_space">
			<location name="fp_action" tags="name=fp_action" pos="0.22 -0.3 -0.42" rot="2.0 4.0 0.0"/>
			<location name="tp_action" tags="name=tp_action" pos="0.2 -0.38 -0.25" rot="0.0 0.0 5.0"/>
			<location name="tp_action_crouch" tags="name=tp_action_crouch" pos="0.3 -0.48 -0.25" rot="0.0 0.0 5.0"/>
			<location name="tp_run" tags="name=tp_run" pos="0.2 -0.5 -0.3" rot="20.0 30.0 0.0"/>
			<location name="tp_jump" tags="name=tp_jump" pos="0.2 -0.5 -0.35" rot="30.0 30.0 0.0"/>
			<location name="tp_crouch" tags="name=tp_crouch" pos="0.275 -0.55 -0.15" rot="-15.0 -5.0 5.0"/>
		</group>
		<group name="tool_space">
			<body dynamic="false">
				<vox file="MOD/vox/harpoon_gun.vox" scale="0.5" pos="-0.025 0.1 -0.225"/>
				<vox tags="harpoonspear" file="MOD/vox/harpoon_spear.vox" scale="0.5" pos="-0.025 0.25 -0.375"/>
			</body>
			<location name="tp_action_rh" tags="name=tp_action_rh ik_hand" pos="0.0 0.0 0.0" rot="0.0 90.0 0.0"/>
			<location name="tp_action_lh" tags="name=tp_action_lh ik_hand" pos="-0.03 0.11 -0.35" rot="-45.0 30.0 -30.0"/>
			<location name="tp_run_rh" tags="name=tp_run_rh ik_hand" pos="0.0 0.0 0.0" rot="0.0 90.0 0.0"/>
			<location name="tp_run_lh" tags="name=tp_run_lh ik_hand" pos="-0.025 0.12 -0.35" rot="-90.0 0.0 0.0"/>
			<location name="tp_crouch_rh" tags="name=tp_crouch_rh ik_hand" pos="0.0 0.0 0.0" rot="0.0 90.0 0.0"/>
			<location name="tp_crouch_lh" tags="name=tp_crouch_lh ik_hand" pos="-0.025 0.12 -0.3" rot="-90.0 0.0 0.0"/>
			<location name="muzzle" tags="name=muzzle" pos="0.0 0.275 -0.98" rot="0.0 0.0 0.0"/>
		</group>
	</group>
</prefab>
